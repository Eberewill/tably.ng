{
  "name": "tably",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:api": "cd apps/api && go run ./cmd/api",
    "dev:desktop": "pnpm --filter @tably/restaurant-desktop dev",
    "dev:desktop:web": "pnpm --filter @tably/restaurant-desktop dev:web",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm design:check && pnpm -r test",
    "design:check": "node scripts/check-design-system.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
